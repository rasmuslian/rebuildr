{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@icons/*": ["components/icons/*"],
      "@pictograms/*": ["components/pictograms/*"],
      "@hooks/*": ["hooks/*"],
      "@components/*": ["components/*"],
      "@context/*": ["contexts/*"],
      "@text/*": ["components/typography/*"],
      "@assets/*": ["assets/*"],
      "@constants/*": ["constants/*"],
      "@/*": ["./*"]
    }
  },
  "extends": "expo/tsconfig.base"
}
