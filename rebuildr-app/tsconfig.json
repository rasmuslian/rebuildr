{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@icons/*": ["components/icons/*"],
      "@pictograms/*": ["components/pictograms/*"],
      "@hooks/*": ["hooks/*"],
      "@components/*": ["components/*"],
      "@context/*": ["contexts/*"],
      "@text/*": ["components/typography/*"],
      "@assets/*": ["assets/*"],
      "@constants/*": ["constants/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
