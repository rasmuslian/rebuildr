{
  "name": "rebuildr-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run migration:run:prod && node dist/src/main",
    "start:dev": "op run --env-file=\".env.local.1p\" -- nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "type-check": "tsc --noEmit --skipLibCheck",
    "test": "jest --config ./test/jest.config.json",
    "test:all": "jest --config ./test/jest.config.json && jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run:prod": "typeorm migration:run -d ./dist/src/ormconfig-migrations.js",
    "migration:run": "op run --env-file=\".env.local.1p\" -- npm run typeorm migration:run -- -d ./src/ormconfig-migrations.ts",
    "migration:show": "npm run typeorm migration:show -- -d ./src/ormconfig-migrations.ts",
    "migration:revert": "op run --env-file=\".env.local.1p\" -- npm run typeorm migration:revert -- -d ./src/ormconfig-migrations.ts",
    "migration:generate": "op run --env-file=\".env.local.1p\" -- npm run typeorm migration:generate -- -d ./src/ormconfig-migrations.ts",
    "migration:create": "npm run typeorm migration:create"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.81",
    "@apollo/server": "^4.11.0",
    "@aws-sdk/client-s3": "^3.608.0",
    "@aws-sdk/credential-providers": "^3.606.0",
    "@aws-sdk/s3-request-presigner": "^3.608.0",
    "@google/genai": "^1.45.0",
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@nestjs/apollo": "^12.1.0",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.2",
    "@sentry/nestjs": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@types/mailchimp__mailchimp_marketing": "^3.0.21",
    "ai": "^6.0.202",
    "bankid": "^3.2.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "core-js": "^3.37.1",
    "dataloader": "^2.2.2",
    "dayjs": "^1.11.12",
    "form-data": "^4.0.0",
    "graphql": "^16.9.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jest-mock": "^30.2.0",
    "mailgun.js": "^10.2.1",
    "mjml": "^4.15.3",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "stripe": "^20.2.0",
    "typeorm": "^0.3.20",
    "winston-loki": "^6.1.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.21",
    "@types/bcrypt": "^5.0.2",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/mjml": "^4.7.4",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
