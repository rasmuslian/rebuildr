<mjml>
  <mj-head>
  </mj-head>
  <mj-body background-color="#F8F1E3" height="1024px">
    <mj-section padding-top="100px"></mj-section>
    <mj-section background-color="#FFFFFF" padding-top="50px" padding-bottom="50px" border-radius="12px">
      <mj-column width="400px">
        <mj-text align="center" font-size="21px" font-family="Roboto" color="#343434" font-weight="500">Nytt företagskonto väntar på godkännande</mj-text>
        <mj-text align="center" color="#343434" font-family="Roboto" font-size="16px" line-height="25px">
          Ett nytt företagskonto har registrerats och väntar på godkännande.
        </mj-text>
        <mj-text align="center" color="#343434" font-family="Roboto" font-size="16px" line-height="25px">
          <strong>E-post:</strong> {{businessEmail}}<br />
          <strong>Organisationsnummer:</strong> {{organizationNumber}}
        </mj-text>
        <mj-text align="center" color="#343434" font-family="Roboto" font-size="16px" line-height="25px">
          Kontakta företagsrepresentanten och godkänn kontot via admin-panelen när ni är klara.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding-top="56px" padding-bottom="40px">
      <mj-column>
        <mj-image src={{logo}} alt="RebuildR logo" width="180px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
