<mjml>
  <mj-head>
  </mj-head>
  <mj-body background-color="#00493E">
    <mj-section padding-top="100px"></mj-section>
    <mj-section background-color="#F8F1E3" padding-top="50px" padding-bottom="50px">
      <mj-column width="400px">
        
        <mj-text align="center" font-size="21px" font-family="Roboto" color="#343434" font-weight="500">
          Du har fått ett nytt meddelande angående: <b>{{productTitle}}</b>
        </mj-text>
        
        <mj-text align="center" font-size="16px" font-family="Roboto" color="#343434" line-height="25px">
          Logga in på RebuildR för att läsa
        </mj-text>
        
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>